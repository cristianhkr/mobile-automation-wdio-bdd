{
  "name": "mobile-automation-wdio-bdd",
  "version": "1.0.0",
  "description": "PoC for native mobile automation with WebdriverIO + Appium + Cucumber + POM + Allure",
  "main": "index.js",
  "scripts": {
    "test:android": "wdio run wdio.conf.ts --spec src/features/login.feature",
    "test:android:live": "bash scripts/test-live.sh",
    "test:android:smoke": "wdio run wdio.conf.ts --spec src/features/login.feature --cucumberOpts.tagExpression \"@smoke\"",
    "wdio": "wdio run wdio.conf.ts",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "appium:drivers": "appium driver list",
    "appium:install:uiautomator2": "appium driver install uiautomator2",
    "clean:allure": "rm -rf allure-results allure-report",
    "emulator": "/opt/homebrew/share/android-commandlinetools/emulator/emulator -avd Pixel_6_API_34 -no-audio",
    "emulator:headless": "/opt/homebrew/share/android-commandlinetools/emulator/emulator -avd Pixel_6_API_34 -no-window -no-audio"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "cucumber",
    "bdd",
    "mobile-automation",
    "allure",
    "page-object-model"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@wdio/allure-reporter": "^10.2.0",
    "@wdio/appium-service": "^10.2.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/cucumber-framework": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/types": "^10.2.0",
    "allure-commandline": "^2.32.0",
    "appium": "^4.0.0",
    "appium-uiautomator2-driver": "^10.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "expect-webdriverio": "^8.1.0"
  }
}
