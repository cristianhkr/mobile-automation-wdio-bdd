{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["src/pages/*"],
      "@step-definitions/*": ["src/step-definitions/*"],
      "@features/*": ["src/features/*"]
    },
    "types": ["node", "@wdio/globals/types", "@wdio/cucumber-framework", "expect-webdriverio"]
  },
  "include": ["src/**/*.ts", "wdio.conf.ts"],
  "exclude": ["node_modules", "dist", "allure-results", "allure-report"],
  "ts-node": {
    "files": true
  }
}
